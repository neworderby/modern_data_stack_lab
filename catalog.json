{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/catalog/v1.json", "dbt_version": "1.10.23", "generated_at": "2026-10-04T16:22:13.829660Z", "invocation_id": "fcb572e2-5277-4cef-bc58-fc80b633ad5f", "invocation_started_at": "2026-10-04T16:22:11.903206Z", "env": {}}, "nodes": {"seed.dbt_dwh.age_groups": {"metadata": {"type": "BASE TABLE", "schema": "raw", "name": "age_groups", "database": "dwh", "comment": "Age groups to split users for analysis", "owner": "admin"}, "columns": {"group": {"type": "text", "index": 1, "name": "group", "comment": "Unique age group name"}, "age_start": {"type": "integer", "index": 2, "name": "age_start", "comment": null}, "age_end": {"type": "integer", "index": 3, "name": "age_end", "comment": null}}, "stats": {"has_stats": {"id": "has_stats", "label": "Has Stats?", "value": false, "include": false, "description": "Indicates whether there are statistics for this table"}}, "unique_id": "seed.dbt_dwh.age_groups"}, "model.dbt_dwh.book_scooter_retention": {"metadata": {"type": "BASE TABLE", "schema": "raw", "name": "book_scooter_retention", "database": "dwh", "comment": "Retention analysis which tells how many people started search for scooter and finally booked it on or after 1, 7, 14 days (or weeks, months, years), etc\n", "owner": "admin"}, "columns": {"period": {"type": "integer", "index": 1, "name": "period", "comment": null}, "unique_users": {"type": "bigint", "index": 2, "name": "unique_users", "comment": null}, "pct_users": {"type": "numeric", "index": 3, "name": "pct_users", "comment": null}}, "stats": {"has_stats": {"id": "has_stats", "label": "Has Stats?", "value": false, "include": false, "description": "Indicates whether there are statistics for this table"}}, "unique_id": "model.dbt_dwh.book_scooter_retention"}, "model.dbt_dwh.companies": {"metadata": {"type": "BASE TABLE", "schema": "raw", "name": "companies", "database": "dwh", "comment": "Scooter satistics by company", "owner": "admin"}, "columns": {"company"